<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetLibVersion)</TargetFramework>
    <RootNamespace>dddlib.Persistence.SqlServer</RootNamespace>
    <Description>SQL Server persistence for dddlib: event store, snapshot store, identity map and memento repositories.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="dddlib.Persistence.Tests" />
    <InternalsVisibleTo Include="dddlib.Tests.Support" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../dddlib.Persistence/dddlib.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL Server infrastructure shared with dddlib.Persistence.EventDispatcher.SqlServer as linked files. -->
    <Compile Include="../Shared/SqlServer/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The numbered schema scripts, the same in every SQL Server package: embedded for SqlServerSchemaInstaller and
         shipped as content for running by hand. -->
    <EmbeddedResource Include="../Shared/SqlServer/Scripts/*.sql" Link="Scripts/%(Filename)%(Extension)" LogicalName="dddlib.SqlServer.Scripts.%(Filename)%(Extension)" />
    <Content Include="../Shared/SqlServer/Scripts/*.sql" Link="Scripts/%(Filename)%(Extension)" Pack="true" PackagePath="content/Scripts;contentFiles/any/any/Scripts" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
