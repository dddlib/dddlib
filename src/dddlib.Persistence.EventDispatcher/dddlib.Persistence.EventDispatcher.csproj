<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetLibVersion)</TargetFramework>
    <RootNamespace>dddlib.Persistence.EventDispatcher</RootNamespace>
    <Description>Dispatches the events persisted by dddlib.Persistence to a handler, in order, with at-least-once delivery, polling an event store. SQL Server is in dddlib.Persistence.EventDispatcher.SqlServer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="dddlib.Persistence.EventDispatcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../dddlib.Persistence/dddlib.Persistence.csproj" />
  </ItemGroup>

</Project>
