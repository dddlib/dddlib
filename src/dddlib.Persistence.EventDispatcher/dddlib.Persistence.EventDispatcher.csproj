<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetLibVersion)</TargetFramework>
    <RootNamespace>dddlib.Persistence.EventDispatcher</RootNamespace>
    <Description>Dispatches the events persisted by dddlib.Persistence to a handler, in order, with at-least-once delivery, polling an in-memory or SQL Server event store.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="dddlib.Persistence.EventDispatcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../dddlib.Persistence/dddlib.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts/*.sql" LogicalName="dddlib.Persistence.EventDispatcher.Scripts.%(Filename)%(Extension)" />
    <Content Include="Scripts/*.sql" Pack="true" PackagePath="content/Scripts;contentFiles/any/any/Scripts" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
