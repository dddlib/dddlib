<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetLibVersion)</TargetFramework>
    <RootNamespace>dddlib.Persistence</RootNamespace>
    <Description>Persistence for dddlib: event store and memento repositories with an in-memory implementation. SQL Server is in dddlib.Persistence.SqlServer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="dddlib.Persistence.EventDispatcher" />
    <InternalsVisibleTo Include="dddlib.Persistence.EventDispatcher.SqlServer" />
    <InternalsVisibleTo Include="dddlib.Persistence.SqlServer" />
    <InternalsVisibleTo Include="dddlib.Persistence.Tests" />
    <InternalsVisibleTo Include="dddlib.Tests.Support" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../dddlib/dddlib.csproj" />
  </ItemGroup>

</Project>
